# Keep the build context small, and keep secrets out of it.
# The Dockerfile COPYs an explicit file list, but nothing that is not needed to
# build should ever be sent to the daemon in the first place.

app/
images/
tests/
.git/
.github/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

docker_run.txt
requirements-dev.txt
pytest.ini
README.md
